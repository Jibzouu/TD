{
  "name": "journal-de-trading",
  "version": "2.0.0",
  "private": true,
  "description": "Journal de trading (Live · Backtest · PropFirm) — un seul fichier HTML, données 100 % locales.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node build.mjs && node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:visual": "node tests/visual/compare.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "chart.js": "4.4.1",
    "playwright": "1.56.1"
  }
}
